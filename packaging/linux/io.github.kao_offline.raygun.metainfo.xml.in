<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>io.github.kao_offline.raygun</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>
  <name>Raygun</name>
  <summary>Organise photos and develop raw files, non-destructively</summary>
  <developer id="io.github.kao_offline">
    <name>kao-offline</name>
  </developer>
  <description>
    <p>
      Raygun is a photo library and raw developer. Organise photos and develop raw files, non-destructively
    </p>
  </description>
  <launchable type="desktop-id">io.github.kao_offline.raygun.desktop</launchable>
  <icon type="stock">io.github.kao_offline.raygun</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/kao-offline/raygun</url>
  <url type="bugtracker">https://github.com/kao-offline/raygun/issues</url>
  <url type="help">https://github.com/kao-offline/raygun</url>
  <categories>
    <category>Graphics</category>
    <category>RasterGraphics</category>
    <category>Photography</category>
  </categories>
  <keywords>
    <keyword>photo</keyword>
    <keyword>image editor</keyword>
    <keyword>psd</keyword>
    <keyword>layers</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>lightcraft</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
